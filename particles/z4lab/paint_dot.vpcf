{
	_class = "CParticleSystemDefinition"
	m_nMaxParticles = 1
	m_nInitialParticles = 1
	m_flConstantRadius = 8.0
	m_ConstantColor = [ 255, 255, 255, 255 ]
	m_bShouldSort = false
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_nOrientationType = "PARTICLE_ORIENTATION_ALIGN_TO_PARTICLE_NORMAL"
			m_bBlendFramesSeq0 = false
			m_vecTexturesInput =
			[
				{
					m_hTexture = resource:"materials/z4lab/paint_dot.vtex"
				},
			]
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_InstantaneousEmitter"
			m_nParticlesToEmit =
			{
				m_nType = "PF_TYPE_LITERAL"
				m_flLiteralValue = 1.0
			}
		},
	]
	m_Initializers =
	[
		// At control point 0 (the entity), lying flat: the normal is the entity's forward axis (the surface normal)
		{
			_class = "C_INIT_CreateWithinSphereTransform"
		},
		{
			_class = "C_INIT_NormalAlignToCP"
		},
		// Radius = half the dot size (control point 2's x, the plugin's DataCPValue)
		{
			_class = "C_INIT_InitFloat"
			m_nOutputField = 3
			m_InputValue =
			{
				m_nType = "PF_TYPE_CONTROL_POINT_COMPONENT"
				m_nControlPoint = 2
				m_nVectorComponent = 0
				m_nMapType = "PF_MAP_TYPE_REMAP"
				m_flInput0 = 0.0
				m_flInput1 = 1000.0
				m_flOutput0 = 0.0
				m_flOutput1 = 500.0
			}
		},
		// Color = control point 1 (the plugin's Tint, 0-255)
		{
			_class = "C_INIT_RemapTransformToVector"
			m_nFieldOutput = 6
			m_vInputMin = [ 0.0, 0.0, 0.0 ]
			m_vInputMax = [ 255.0, 255.0, 255.0 ]
			m_vOutputMin = [ 0.0, 0.0, 0.0 ]
			m_vOutputMax = [ 1.0, 1.0, 1.0 ]
			m_TransformInput =
			{
				m_nType = "PT_TYPE_CONTROL_POINT"
				m_nControlPoint = 1
			}
		},
	]
}
